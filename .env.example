# Copy this file to .env and add your own Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional response-speed tuning (fast primary model, one fallback).
# DO_GEMINI_MODEL=gemini-3.5-flash-lite
# DO_GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Optional: required only for the email-reading voice command. For Gmail, use an app password.
EMAIL_USER=
EMAIL_PASS=

# Website hosting only: set these as server environment variables at your host.
# DO_HOSTED_MODE=1
# DO_ACCESS_CODE=use-a-long-random-secret
